# Copy to .env and fill in what you use. .env is git-ignored; this example file is not, so never put a real key here.
# altera.py calls load_dotenv() at startup, and core/config.py reads ALTERA_<PROVIDER>_API_KEY for each provider's key --
# so a key set here never has to be written into config.yaml at all.

# OpenAI. From platform.openai.com, billed per token. A ChatGPT Plus subscription is a different product and does
# not include an API key.
# ALTERA_OPENAI_API_KEY=sk-...

# OpenRouter (one key, many models).
# ALTERA_OPENROUTER_API_KEY=sk-or-...

# Web search extras, if you enable them in config.yaml.
# ALTERA_SERPAPI_API_KEY=
# ALTERA_OPENWEATHERMAP_API_KEY=

# Signs the session cookie. Generated into data/secret_key on first run if unset; set it here to pin it.
# ALTERA_SECRET_KEY=

# INFO by default. DEBUG shows the streaming and picture traces.
# ALTERA_LOG_LEVEL=DEBUG
